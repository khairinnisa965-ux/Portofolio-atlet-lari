    <!-- Interactive Script -->
    <script>
        // Mobile menu toggle logic
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Form Submission Handling (Without alert)
        function handleFormSubmit(event) {
            event.preventDefault();
            const alertBox = document.getElementById('alert-box');
            
            // Show Success Notification in UI
            alertBox.className = "mb-6 p-4 rounded-xl text-sm font-semibold bg-green-500/20 border border-green-500 text-green-300 block";
            alertBox.innerHTML = "<i class='fa-solid fa-circle-check mr-2'></i> Pesan Anda berhasil dikirim! Khairinnisa akan segera menghubungi Anda.";

            // Reset Form
            document.getElementById('contact-form').reset();

            // Auto Hide Alert
            setTimeout(() => {
                alertBox.className = "hidden";
            }, 6000);
        }
    </script>
